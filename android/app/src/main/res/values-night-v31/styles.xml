<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/sunday_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Keep the launch artwork visible while Flutter prepares its first
             frame, avoiding a blank flash after Android 12's system splash. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
