rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isMember(groupId, userId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/members/$(userId)
      );
    }

    function memberRole(groupId, userId) {
      return get(
        /databases/$(database)/documents/groups/$(groupId)/members/$(userId)
      ).data.role;
    }

    function isAdmin(groupId, userId) {
      return isMember(groupId, userId)
        && memberRole(groupId, userId) == "admin";
    }

    function isBlockedFromGroup(groupId, userId) {
      return exists(
        /databases/$(database)/documents/groups/$(groupId)/blockedUsers/$(userId)
      );
    }

    function isSundayUploadWindowOpen() {
      return (
          request.time.dayOfWeek() == 6
          && request.time.time() >= duration.time(22, 0, 0, 0)
        )
        || request.time.dayOfWeek() == 7;
    }

    function validWeekDocument(groupId, weekKey) {
      return request.resource.data.keys().hasOnly([
          "weekKey",
          "isoYear",
          "isoWeek",
          "createdAt",
          "postCount"
        ])
        && request.resource.data.weekKey == weekKey
        && request.resource.data.isoYear is int
        && request.resource.data.isoWeek is int
        && request.resource.data.postCount == 0
        && request.resource.data.createdAt == request.time;
    }

    function validChatMessageCreate(groupId, weekKey) {
      return isSundayUploadWindowOpen()
        && request.resource.data.keys().hasOnly([
          "uid",
          "authorName",
          "authorPhotoUrl",
          "text",
          "type",
          "gifUrl",
          "gifLabel",
          "weekKey",
          "createdAt"
        ])
        && request.resource.data.uid == uid()
        && request.resource.data.weekKey == weekKey
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (
          request.resource.data.authorPhotoUrl == null
          || request.resource.data.authorPhotoUrl is string
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (
          request.resource.data.gifUrl == null
          || isValidTrustedGifUrl(request.resource.data.gifUrl)
        )
        && (
          request.resource.data.gifLabel == null
          || (
            request.resource.data.gifLabel is string
            && request.resource.data.gifLabel.size() <= 80
          )
        )
        && (
          request.resource.data.type == null
          || request.resource.data.type == "text"
          || request.resource.data.type == "gif"
          || request.resource.data.type == "mixed"
        )
        && (
          request.resource.data.text.size() > 0
          || (
            request.resource.data.gifUrl is string
            && request.resource.data.gifUrl.size() > 0
          )
        )
        && request.resource.data.createdAt == request.time;
    }

    function isValidTrustedGifUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2000
        && (
          value.matches("^https://media\\.tenor\\.com/[^\\s]+$")
          || value.matches("^https://media[0-9]*\\.giphy\\.com/[^\\s]+$")
        );
    }

    function validGroupActivityUpdate(groupId) {
      return isSignedIn()
        && isMember(groupId, uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastActivityAt"
        ])
        && request.resource.data.lastActivityAt == request.time;
    }

    function validAdminGroupNameUpdate(groupId) {
      return isSignedIn()
        && isAdmin(groupId, uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "updatedAt",
          "lastActivityAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityAt == request.time;
    }

    function validAdminGroupPhotoUpdate(groupId) {
      return isSignedIn()
        && isAdmin(groupId, uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "photoUrl",
          "photoStoragePath",
          "updatedAt",
          "lastActivityAt"
        ])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() > 0
        && request.resource.data.photoStoragePath is string
        && request.resource.data.photoStoragePath.size() > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityAt == request.time;
    }

    function validUserGroupActivityMirrorCreate(groupId) {
      return isSignedIn()
        && isMember(groupId, uid())
        && request.resource.data.keys().hasOnly([
          "groupId",
          "lastActivityAt"
        ])
        && request.resource.data.groupId == groupId
        && request.resource.data.lastActivityAt == request.time;
    }

    function validUserGroupActivityMirrorUpdate(groupId) {
      return isSignedIn()
        && isMember(groupId, uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "groupId",
          "lastActivityAt"
        ])
        && request.resource.data.groupId == groupId
        && request.resource.data.lastActivityAt == request.time;
    }

    function validOwnMemberProfileUpdate(memberUid) {
      return isSignedIn()
        && memberUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "effectiveName",
          "effectivePhotoUrl",
          "groupNameOverride",
          "profileSyncedAt"
        ])
        && (
          request.resource.data.effectiveName == null
          || (
            request.resource.data.effectiveName is string
            && request.resource.data.effectiveName.size() <= 80
          )
        )
        && (
          request.resource.data.effectivePhotoUrl == null
          || request.resource.data.effectivePhotoUrl is string
        )
        && (
          request.resource.data.groupNameOverride == null
          || (
            request.resource.data.groupNameOverride is string
            && request.resource.data.groupNameOverride.size() > 0
            && request.resource.data.groupNameOverride.size() <= 80
          )
        )
        && request.resource.data.profileSyncedAt == request.time;
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);

      match /groups/{groupId} {
        allow read: if isSelf(userId)
          || (
            isSignedIn()
            && isAdmin(groupId, uid())
          );

        allow create: if isSelf(userId)
          || (
            isSignedIn()
            && isAdmin(groupId, uid())
          )
          || validUserGroupActivityMirrorCreate(groupId);

        allow update: if isSelf(userId)
          || (
            isSignedIn()
            && isAdmin(groupId, uid())
          )
          || validUserGroupActivityMirrorUpdate(groupId);

        allow delete: if isSelf(userId)
          || (
            isSignedIn()
            && isAdmin(groupId, uid())
          );
      }

      match /notificationTokens/{tokenId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /reports/{reportId} {
      allow read, create, update, delete: if false;
    }

    match /suggestions/{suggestionId} {
      allow read, update, delete: if false;
      allow create: if false;
    }

    match /inviteCodes/{inviteCode} {
      allow get: if isSignedIn()
        && resource.data.active == true
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.deleted != true;

      allow list: if false;

      allow create, update, delete: if false;
    }

    match /groups/{groupId} {

      allow get: if isSignedIn()
        && isMember(groupId, uid());

      allow list: if false;

      allow create: if false;

      allow update: if validGroupActivityUpdate(groupId)
        || validAdminGroupNameUpdate(groupId)
        || validAdminGroupPhotoUpdate(groupId);

      allow delete: if false;

      match /members/{memberUid} {

        allow get: if isSignedIn()
          && (
            isMember(groupId, uid())
            || memberUid == uid()
          );

        allow list: if isSignedIn()
          && isMember(groupId, uid());

        allow create: if false;

        allow update: if validOwnMemberProfileUpdate(memberUid);

        allow delete: if false;
      }

      match /joinRequests/{requestUid} {

        allow create: if false;

        allow read: if isSignedIn()
          && (
            isMember(groupId, uid())
            || requestUid == uid()
          );

        allow update, delete: if false;
      }

      match /blockedUsers/{blockedUid} {

        allow get: if isSignedIn()
          && (
            blockedUid == uid()
            || isAdmin(groupId, uid())
          );

        allow list: if isSignedIn()
          && isAdmin(groupId, uid());

        allow create, update, delete: if false;
      }

      match /weeks/{weekKey} {

        allow read: if isSignedIn()
          && isMember(groupId, uid());

        allow create: if isSignedIn()
          && isMember(groupId, uid())
          && isSundayUploadWindowOpen()
          && validWeekDocument(groupId, weekKey);

        allow update: if false;

        allow delete: if false;

        match /chatMessages/{messageId} {

          allow read: if isSignedIn()
            && isMember(groupId, uid());

          allow create: if isSignedIn()
            && isMember(groupId, uid())
            && validChatMessageCreate(groupId, weekKey);

          allow update, delete: if false;
        }

        match /reminders/{reminderId} {

          allow read: if isSignedIn()
            && isMember(groupId, uid());

          allow create, update, delete: if false;
        }

        match /posts/{postUid} {

          allow read: if isSignedIn()
            && isMember(groupId, uid());

          allow create, update, delete: if false;

          match /reactions/{reactionUid} {

            allow read: if isSignedIn()
              && isMember(groupId, uid());

            allow create, update, delete: if false;
          }
        }
      }
    }
  }
}
