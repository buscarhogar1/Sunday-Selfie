rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function isAdmin(groupId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isSundayUploadWindowOpen() {
      return (
          request.time.dayOfWeek() == 6
          && request.time.time() >= duration.time(22, 0, 0, 0)
        )
        || request.time.dayOfWeek() == 7;
    }

    function isLateMondayUploadWindowOpen() {
      return request.time.dayOfWeek() == 1
        || (
          request.time.dayOfWeek() == 7
          && request.time.time() >= duration.time(22, 0, 0, 0)
        );
    }

    function isLateMondayUpload() {
      return "lateUpload" in request.resource.metadata
        && "rewardedAdWatched" in request.resource.metadata
        && request.resource.metadata.lateUpload == "true"
        && request.resource.metadata.rewardedAdWatched == "true";
    }

    function isRewardedReplacement() {
      return "replacement" in request.resource.metadata
        && "rewardedAdWatched" in request.resource.metadata
        && "replacementUploadId" in request.resource.metadata
        && request.resource.metadata.replacement == "true"
        && request.resource.metadata.rewardedAdWatched == "true"
        && request.resource.metadata.replacementUploadId.matches("[0-9]+");
    }

    function isJpegUpload() {
      return request.resource.contentType == "image/jpeg";
    }

    function isUserProfilePhotoFileName(fileName) {
      return fileName.matches("base_[0-9]+\\.jpg");
    }

    function isGroupProfilePhotoFileName(fileName) {
      return fileName.matches("group_[0-9]+\\.jpg");
    }

    function isValidSelfieUpload(groupId, weekKey, fileName) {
      return isMember(groupId)
        && (
          isSundayUploadWindowOpen()
          || (
            isLateMondayUploadWindowOpen()
            && isLateMondayUpload()
          )
        )
        && request.resource != null
        && resource == null
        && fileName == request.auth.uid + ".jpg"
        && request.resource.size < 10 * 1024 * 1024
        && isJpegUpload()
        && !("replacement" in request.resource.metadata)
        && request.resource.metadata.groupId == groupId
        && request.resource.metadata.weekKey == weekKey
        && request.resource.metadata.uid == request.auth.uid;
    }

    function isValidSelfieThumbnailUpload(groupId, weekKey, fileName) {
      return isMember(groupId)
        && (
          isSundayUploadWindowOpen()
          || (
            isLateMondayUploadWindowOpen()
            && isLateMondayUpload()
          )
        )
        && request.resource != null
        && resource == null
        && fileName == request.auth.uid + ".jpg"
        && request.resource.size < 2 * 1024 * 1024
        && isJpegUpload()
        && !("replacement" in request.resource.metadata)
        && request.resource.metadata.groupId == groupId
        && request.resource.metadata.weekKey == weekKey
        && request.resource.metadata.uid == request.auth.uid
        && request.resource.metadata.kind == "selfieThumb";
    }

    function isValidReplacementSelfieUpload(groupId, weekKey, fileName) {
      return isMember(groupId)
        && isSundayUploadWindowOpen()
        && request.resource != null
        && resource == null
        && isRewardedReplacement()
        && fileName == request.auth.uid + "_"
          + request.resource.metadata.replacementUploadId + ".jpg"
        && request.resource.size < 10 * 1024 * 1024
        && isJpegUpload()
        && request.resource.metadata.groupId == groupId
        && request.resource.metadata.weekKey == weekKey
        && request.resource.metadata.uid == request.auth.uid;
    }

    function isValidReplacementSelfieThumbnailUpload(groupId, weekKey, fileName) {
      return isMember(groupId)
        && isSundayUploadWindowOpen()
        && request.resource != null
        && resource == null
        && isRewardedReplacement()
        && fileName == request.auth.uid + "_"
          + request.resource.metadata.replacementUploadId + ".jpg"
        && request.resource.size < 2 * 1024 * 1024
        && isJpegUpload()
        && request.resource.metadata.groupId == groupId
        && request.resource.metadata.weekKey == weekKey
        && request.resource.metadata.uid == request.auth.uid
        && request.resource.metadata.kind == "selfieThumb";
    }

    function isValidProfilePhotoUpload(userId, fileName) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource != null
        && isUserProfilePhotoFileName(fileName)
        && request.resource.size < 8 * 1024 * 1024
        && isJpegUpload()
        && request.resource.metadata.uid == userId
        && request.resource.metadata.kind == "profilePhoto";
    }

    function isValidGroupPhotoUpload(groupId, fileName) {
      return isAdmin(groupId)
        && request.resource != null
        && isGroupProfilePhotoFileName(fileName)
        && request.resource.size < 8 * 1024 * 1024
        && isJpegUpload()
        && request.resource.metadata.groupId == groupId
        && request.resource.metadata.uid == request.auth.uid
        && request.resource.metadata.kind == "groupPhoto";
    }

    match /groups/{groupId}/weeks/{weekKey}/{fileName} {
      allow read: if isMember(groupId);

      allow create: if isValidSelfieUpload(groupId, weekKey, fileName);

      allow update, delete: if false;
    }

    match /groups/{groupId}/weeks/{weekKey}/thumbs/{fileName} {
      allow read: if isMember(groupId);

      allow create: if isValidSelfieThumbnailUpload(groupId, weekKey, fileName);

      allow update, delete: if false;
    }

    match /groups/{groupId}/weeks/{weekKey}/replacements/{fileName} {
      allow read: if isMember(groupId);

      allow create: if isValidReplacementSelfieUpload(groupId, weekKey, fileName);

      allow update, delete: if false;
    }

    match /groups/{groupId}/weeks/{weekKey}/replacements/thumbs/{fileName} {
      allow read: if isMember(groupId);

      allow create: if isValidReplacementSelfieThumbnailUpload(groupId, weekKey, fileName);

      allow update, delete: if false;
    }

    match /groups/{groupId}/profile/{fileName} {
      allow read: if isMember(groupId);

      allow create, update: if isValidGroupPhotoUpload(groupId, fileName);

      allow delete: if isAdmin(groupId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn();

      allow create: if isValidProfilePhotoUpload(userId, fileName);

      allow update: if isValidProfilePhotoUpload(userId, fileName);

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }
  }
}
